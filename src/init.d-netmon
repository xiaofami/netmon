#!/bin/sh /etc/rc.common
#
# netmon - 网络监控服务
#
# 注意：本服务只读取 /proc/net/nf_conntrack 并旁路嗅探 udp/53，
# 不发探测包、不修改任何网络配置，不碰 dnsmasq / homeproxy / 防火墙。
# 所以启停它不会影响任何设备的网络。

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/netmon
CONF=/etc/config/netmon

start_service() {
	# apk 3 在装包时会把「被用户改动过」的配置的原版另存为
	# /etc/config/netmon.apk-new，而且是在 post-install 跑完之后才落盘，
	# 包脚本里删不到。这里在每次启动时顺手扫掉，装完第一次重启或下次开机即清。
	rm -f "$CONF.apk-new"

	# 先读 UCI 配置。<netmon 段名就是 'main'>，
	# 配置文件不存在时 config_load 会失败，用缺省值继续。
	config_load netmon 2>/dev/null || true

	# 从 UCI 读配置，缺省值保证即使配置文件不存在也能启动
	config_get_bool enabled  main enabled   1
	config_get      dbpath   main db_path   "/opt/netmon/data/netmon.db"
	config_get      interval main interval  5
	config_get      retain   main retain    30
	config_get      loglevel main loglevel  0
	# DNS 嗅探接口（br-lan / any）；any 由 netmon 内部映射成「不 bind 网卡、
	# 收全部网卡」，这里原样传值即可。
	config_get      sniffif  main dns_sniff_if "br-lan"
	[ "$enabled" = "1" ] || {
		logger -t netmon "disabled in config, not starting"
		return 0
	}

	[ -x "$PROG" ] || {
		logger -t netmon "binary missing: $PROG"
		return 1
	}

	# 已停用主动探测：不再需要 WAN 源地址，也不再传任何探针参数。
	mkdir -p "$(dirname "$dbpath")"

	procd_open_instance netmon
	procd_set_param command "$PROG" \
		-d "$dbpath" \
		-i "$((interval * 1000))" \
		-r "$retain" \
		--sniff-if "$sniffif"

	[ "$loglevel" = "1" ] && procd_append_param command -v

	# 崩溃自动重启，并做退避，避免疯狂重启
	procd_set_param respawn 3600 5 5

	# 日志交给 procd 收集，可通过 logread -e netmon 查看
	procd_set_param stdout 1
	procd_set_param stderr 1

	# 资源限制：防止异常情况下吃满内存
	procd_set_param limits core="0 0"

	procd_close_instance

	logger -t netmon "started: bin=$PROG db=$dbpath interval=${interval}s retain=${retain}d sniff_if=$sniffif"
}

service_triggers() {
	# 主动探测已停用，不再需要跟着 WAN 重新拨号重启。
	# UCI 配置变更由 LuCI 设置页调用 /usr/bin/netmon-apply 统一处理。
	procd_add_reload_trigger "netmon"
}

reload_service() {
	stop
	start
}
